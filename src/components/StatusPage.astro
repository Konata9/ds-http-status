---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StatusPicture from '../components/StatusPicture.astro';
import { classMeta, getStatus, statuses, type Locale, type Status } from '../data/statuses';
import { homePath, withBase } from '../data/site';
import { ui } from '../i18n/ui';
import { statusDescription, statusJsonLd, statusTitle } from '../lib/seo';
import { statusUrls } from '../lib/statusUrls';

interface Props {
  locale: Locale;
  status: Status;
}

const { locale, status } = Astro.props;
const t = ui[locale];
const urls = statusUrls(status.code);
const path = urls.page[locale].path;
const index = statuses.findIndex((item) => item.code === status.code);
const previous = index > 0 ? statuses[index - 1] : undefined;
const next = index < statuses.length - 1 ? statuses[index + 1] : undefined;
const className = classMeta[status.class][locale];
const imageUrl = urls.image.url;

const pagerLabel = (target: Status) =>
  `${target.code} ${target.reason}`;
---

<BaseLayout
  locale={locale}
  title={statusTitle(locale, status)}
  description={statusDescription(locale, status)}
  path={path}
  type="article"
  image={{
    url: imageUrl,
    alt: status.imageAlt[locale],
    width: 1254,
    height: 1254,
  }}
  jsonLd={statusJsonLd(locale, status)}
>
  <article class="detail container">
    <Breadcrumb
      items={[
        { name: t.nav.index, href: withBase(homePath(locale)) },
        { name: `${status.code} ${status.reason}` },
      ]}
    />

    <div class="detail-grid">
      <header class="detail-head">
        <h1>
          <span class="detail-title-line">
            <span class="detail-code">{status.code}</span>
            <span class="detail-reason">{status.reason}</span>
          </span>
          {locale === 'zh' && <span class="detail-zh">{status.reasonZh}</span>}
        </h1>
        <p class="lede detail-lede">{status.lead[locale]}</p>
      </header>

      <figure class="detail-plate">
        <div class="detail-image">
          <StatusPicture
            status={status}
            locale={locale}
            widths={[560, 960, 1254]}
            sizes="(min-width: 960px) 42vw, 100vw"
            loading="eager"
          />
        </div>
        <figcaption>
          <span class="plate-no">{t.detail.plateLabel} {status.plate}</span>
          <span class="plate-name">{status.code} {status.reason}</span>
          <span class="plate-class">{className}</span>
        </figcaption>
      </figure>

      <div class="detail-body">
        <section class="detail-section">
          <h2>{t.detail.meaningH}</h2>
          {status.meaning[locale].map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="detail-section">
          <h2>{t.detail.whenH}</h2>
          <ul>
            {status.when[locale].map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="detail-section">
          <h2>{t.detail.fixH}</h2>
          <div class="fix-grid">
            <div>
              <h3>{t.detail.serverH}</h3>
              <ul>
                {status.server[locale].map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3>{t.detail.visitorH}</h3>
              <ul>
                {status.visitor[locale].map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <section class="detail-section direct-links">
          <h2>{t.detail.directH}</h2>
          <dl class="meta-rows direct-list">
            <div>
              <dt>{t.detail.imageLabel}</dt>
              <dd><a href={imageUrl}>{imageUrl}</a></dd>
            </div>
          </dl>
        </section>

        <section class="detail-section">
          <h2>{t.detail.techH}</h2>
          <dl class="meta-rows tech-list">
            <div>
              <dt>{t.detail.classLabel}</dt>
              <dd>{className}</dd>
            </div>
            <div>
              <dt>{t.detail.rfcLabel}</dt>
              <dd><a href={status.tech.rfcUrl} rel="noopener">{status.tech.rfc}</a></dd>
            </div>
            <div>
              <dt>{t.detail.cacheableLabel}</dt>
              <dd>{status.tech.cacheable ? t.detail.yes : t.detail.no}</dd>
            </div>
            {status.tech.headers.length > 0 && (
              <div>
                <dt>{t.detail.headersLabel}</dt>
                <dd class="mono">{status.tech.headers.join(', ')}</dd>
              </div>
            )}
          </dl>
          {status.tech.note && <p class="tech-note">{status.tech.note[locale]}</p>}
        </section>

        <section class="detail-section">
          <h2>{t.detail.relatedH}</h2>
          <ul class="meta-rows related-list">
            {status.related.map((related) => {
              const target = getStatus(related.code);
              return (
                <li>
                  <a href={statusUrls(target.code).page[locale].href}>
                    {target.code} {target.reason}
                  </a>
                  <span>{related.note[locale]}</span>
                </li>
              );
            })}
          </ul>
        </section>

        <section class="detail-section sources">
          <h2>{t.detail.sourcesH}</h2>
          <ul>
            {status.sources.map((source) => (
              <li><a href={source.url} rel="noopener">{source.label}</a></li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <nav class="pager" aria-label={locale === 'zh' ? '图版翻页' : 'Plate navigation'}>
      {previous ? (
        <a class="pager-link pager-prev" href={statusUrls(previous.code).page[locale].href}>
          <span class="pager-label">{t.detail.previous}</span>
          <span class="pager-name">{pagerLabel(previous)}</span>
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a class="pager-link pager-next" href={statusUrls(next.code).page[locale].href}>
          <span class="pager-label">{t.detail.next}</span>
          <span class="pager-name">{pagerLabel(next)}</span>
        </a>
      ) : (
        <span></span>
      )}
    </nav>

    <p class="back-link">
      <a href={withBase(homePath(locale))}>{t.detail.backToIndex}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .detail {
    padding-top: clamp(28px, 4vw, 48px);
  }

  .detail-head {
    grid-area: head;
    margin: 0;
  }

  .detail-head h1 {
    display: block;
    max-width: 20ch;
  }

  .detail-title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
  }

  .detail-code {
    font-size: clamp(4rem, 9vw, 7.5rem);
    line-height: 0.95;
  }

  .detail-reason {
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    line-height: 1.05;
  }

  .detail-zh {
    display: block;
    margin-top: 6px;
    color: var(--color-muted);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.4;
  }

  .detail-lede {
    margin-top: clamp(20px, 3vw, 32px);
    max-width: 64ch;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'plate head'
      'plate body';
    column-gap: clamp(32px, 6vw, 80px);
    row-gap: clamp(24px, 4vw, 40px);
    align-items: start;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .detail-plate {
    grid-area: plate;
    margin: 0;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    mix-blend-mode: multiply;
  }

  .detail-image {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .detail-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: normal;
    filter: brightness(1.04);
  }

  .detail-plate figcaption {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .plate-no {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .plate-name {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    line-height: 1.2;
  }

  .plate-class {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .detail-body {
    grid-area: body;
    max-width: 64ch;
  }

  .detail-section + .detail-section {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(28px, 3.5vw, 40px);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .detail-section h2 {
    margin-bottom: 14px;
    font-size: clamp(2rem, 3.6vw, 3.25rem);
  }

  .detail-section p + p {
    margin-top: 1em;
  }

  .detail-section ul {
    margin-top: 0;
    padding-left: 1.2em;
  }

  .detail-section li + li {
    margin-top: 0.45em;
  }

  .detail-section li::marker {
    color: var(--color-accent);
  }

  .fix-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }

  .fix-grid h3 {
    margin-bottom: 10px;
    font-size: 1.25rem;
  }

  .detail-section .meta-rows {
    padding-left: 0;
    list-style: none;
  }

  .meta-rows {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .meta-rows > div,
  .meta-rows > li {
    display: grid;
    grid-template-columns: minmax(120px, 0.8fr) minmax(0, 1.4fr);
    gap: 16px;
    padding: 10px 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .meta-rows dt,
  .meta-rows > li > span {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .meta-rows dd {
    margin: 0;
    font-size: 1rem;
  }

  .meta-rows dd.mono {
    font-size: 1rem;
  }

  .tech-note {
    margin-top: 12px;
    color: var(--color-muted);
    font-size: 1rem;
  }

  .direct-list > div {
    grid-template-columns: minmax(100px, 0.45fr) minmax(0, 1.55fr);
  }

  .direct-list dd {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .direct-list dd a {
    color: var(--color-accent);
  }

  .related-list > li {
    grid-template-columns: minmax(140px, 0.8fr) minmax(0, 1.2fr);
    padding: 11px 0;
  }

  .related-list li + li {
    margin-top: 0;
  }

  .related-list a {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .related-list a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-hair);
  }

  .sources ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    padding-left: 0;
  }

  .sources li + li {
    margin-top: 0;
  }

  .sources a {
    font-size: 1rem;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 20px;
    border-top: var(--rule-strong) solid var(--color-rule-2);
  }

  .pager-link {
    display: grid;
    gap: 4px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .pager-link:hover .pager-name {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-hair);
    text-underline-offset: 0.16em;
  }

  .pager-next {
    text-align: right;
  }

  .pager-label {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .pager-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.15;
  }

  .back-link {
    margin-top: 40px;
    padding-bottom: 8px;
    font-size: 1rem;
  }

  @media (max-width: 959px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'plate'
        'body';
      gap: 32px;
    }

    .detail-plate {
      position: static;
      max-width: 560px;
      margin-inline: auto;
    }

    .detail-image {
      max-width: 560px;
    }
  }

  @media (max-width: 720px) {
    .fix-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .pager-next {
      text-align: left;
    }

    .meta-rows > div,
    .meta-rows > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
