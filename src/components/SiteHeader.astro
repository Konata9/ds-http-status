---
import type { Locale } from '../data/statuses';
import { alternatePath, aboutPath, homePath, site, withBase } from '../data/site';
import { ui } from '../i18n/ui';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = ui[locale];
const home = withBase(homePath(locale));
const about = withBase(aboutPath(locale));
const index = `${home}#plates`;
const switchHref = withBase(alternatePath(path, locale));
const isAbout = path.includes('/about/');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={home} aria-label={site.name[locale]}>
      <span class="wordmark-main">DS<span class="wordmark-slash">/</span>HTTP</span>
      <span class="wordmark-sub">{site.name[locale]}</span>
    </a>
    <nav class="nav" aria-label={locale === 'zh' ? '主导航' : 'Primary'}>
      <a href={index}>{t.nav.index}</a>
      <a href={about} aria-current={isAbout ? 'page' : undefined}>{t.nav.about}</a>
      <a
        class="github-link"
        href={site.author.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <GitHubIcon size={20} />
      </a>
      <a
        class="lang"
        href={switchHref}
        hreflang={t.switchLang}
        lang={t.switchLang}
      >{t.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-paper);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--color-ink);
    text-decoration: none;
    min-width: 0;
  }

  .wordmark-main {
    font-family: var(--font-display);
    font-size: 1.625rem;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark-slash {
    color: var(--color-accent);
    padding-inline: 2px;
  }

  .wordmark-sub {
    color: var(--color-ink-2);
    font-size: 0.875rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    flex: 0 0 auto;
  }

  .nav a {
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-hair);
    text-underline-offset: 0.18em;
  }

  .nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav .lang {
    color: var(--color-accent);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-2);
    line-height: 1;
  }

  .github-link:hover {
    color: var(--color-accent);
  }

  .github-link svg {
    display: block;
  }

  @media (max-width: 900px) {
    .wordmark-sub {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .site-header {
      position: static;
    }

    .header-inner {
      flex-wrap: wrap;
      padding-block: 12px 10px;
      gap: 8px;
    }

    .nav {
      width: 100%;
      justify-content: space-between;
      padding-top: 8px;
      border-top: var(--rule-hair) solid var(--color-rule);
    }
  }
</style>
