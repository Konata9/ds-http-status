---
import { classMeta, groupStatusesByClass, type Locale, type StatusClass } from '../data/statuses';
import { ui } from '../i18n/ui';
import { statusUrls } from '../lib/statusUrls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const classes: StatusClass[] = [2, 4, 5];
const groups = groupStatusesByClass();
---

<div class="family-grid">
  {classes.map((statusClass) => {
    const members = groups[statusClass];
    return (
      <div class="family">
        <p class="family-code">{statusClass}xx</p>
        <p class="family-meaning">{classMeta[statusClass].shortMeaning[locale]}</p>
        <p class="family-links">
          {members.map((status, index) => (
            <>
              {index > 0 && <span class="family-comma" aria-hidden="true">,</span>}
              <a href={statusUrls(status.code).page[locale].href}>{status.code}</a>
            </>
          ))}
        </p>
      </div>
    );
  })}
</div>
<p class="family-outside">{t.families.outside}</p>

<style>
  .family-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    border-top: var(--rule-strong) solid var(--color-rule-2);
  }

  .family {
    padding-top: 18px;
    border-top: var(--rule-hair) solid transparent;
  }

  .family + .family {
    border-left: var(--rule-hair) solid var(--color-rule);
    padding-left: var(--gap);
  }

  .family-code {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .family-meaning {
    margin-top: 12px;
    max-width: 30ch;
    color: var(--color-ink-2);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .family-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .family-links a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .family-links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-hair);
    text-underline-offset: 0.16em;
  }

  .family-comma {
    margin-right: 4px;
    color: var(--color-muted);
  }

  .family-outside {
    margin-top: 22px;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 720px) {
    .family-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .family {
      padding-block: 20px;
      border-top: var(--rule-hair) solid var(--color-rule);
    }

    .family + .family {
      border-left: 0;
      padding-left: 0;
    }

    .family-code {
      font-size: 2.5rem;
    }
  }
</style>
